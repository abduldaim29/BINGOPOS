APP_NAME=BINGOPOS
APP_ENV=production
APP_KEY=base64:z0IAm7yN4+AXZBJVpjCQqOjt8ftXUs6jNkq/e44Po+U=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=https://bingopos.abduldaim2002.workers.dev/
AUTH_PUBLIC_REGISTRATION=true
AUTH_REGISTER_THROTTLE=3,10
AUTH_FORGOT_PASSWORD_THROTTLE=5,10
SESSION_SECURE_COOKIE=true

# Set to a public URL when using Midtrans/Xendit webhooks
XENDIT_CALLBACK_TOKEN=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- UPDATED DATABASE CONFIG FOR RENDER / CLOUD ---
DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-south-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=bingopos_db
DB_USERNAME=postgres.yghyeelucosiellksybc
DB_PASSWORD=""

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

APP_VERSION=v3.0.2

# WhatsApp Gateway (whatsapp-web.js service - note: local background workers won't run natively inside standard Render web services unless hosted separately)
WA_SERVICE_URL=http://localhost:3001

# Payment Gateway — Midtrans
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# Payment Gateway — Xendit
XENDIT_SECRET_KEY=
XENDIT_IS_PRODUCTION=false

# Payment Gateway — Safepay Raast
SAFEPAY_AGGREGATOR_ID=
SAFEPAY_SECRET_KEY=
SAFEPAY_WEBHOOK_SECRET=
SAFEPAY_AGGREGATOR_MERCHANT_IDENTIFIER=
SAFEPAY_IS_PRODUCTION=false

# Inertia SSR (config/inertia.php)
# Note: Node SSR runtime won't work on a pure PHP build unless running a Node container. Set to false if you experience SSR routing errors on Render.
INERTIA_SSR_ENABLED=false
INERTIA_SSR_RUNTIME=node
INERTIA_SSR_ENSURE_RUNTIME_EXISTS=false
INERTIA_SSR_URL=http://127.0.0.1:13714
INERTIA_SSR_ENSURE_BUNDLE_EXISTS=true
INERTIA_SSR_THROW_ON_ERROR=false
INERTIA_ENCRYPT_HISTORY=false

# Security bot guard (config/security.php)
SECURITY_BOT_GUARD_ENABLED=true
SECURITY_BOT_GUARD_HONEYPOT_FIELD=company_website
SECURITY_BOT_GUARD_TOKEN_FIELD=bot_guard_token
SECURITY_BOT_GUARD_MIN_SUBMIT_SECONDS=2
SECURITY_BOT_GUARD_TOKEN_TTL_SECONDS=1800
SECURITY_BOT_GUARD_MESSAGE="Permintaan tidak valid. Silakan coba lagi."

# Security session (config/security.php)
SECURITY_SESSION_ABSOLUTE_LIFETIME_SECONDS=43200
AUTH_PASSWORD_TIMEOUT=900

# Optional mail providers
RESEND_KEY=
POSTMARK_TOKEN=

# Optional Slack logging
SLACK_BOT_USER_OAUTH_TOKEN=
SLACK_BOT_USER_DEFAULT_CHANNEL=

# Optional Sentry (leave empty to disable)
SENTRY_LARAVEL_DSN=
